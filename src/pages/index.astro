---
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Project from '../components/Project.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import { about, manifesto, projects, site } from '../data/portfolio';

const count = String(projects.length).padStart(2, '0');
---

<Layout>
	<div class="pb-20 pt-4">
		<div class="mx-auto w-[calc(100%-40px)] max-w-[880px]">
			<Header />

			<main id="main">
				<Hero />

				<section class="mt-20 scroll-mt-8" id="manifesto" aria-labelledby="manifesto-heading">
					<SectionHeading index="00" label="manifesto" tag="[why]" titleId="manifesto-heading" />

					<div class="mt-4 grid gap-1 text-[15px] leading-6">
						{
							manifesto.questions.map((question, i) => (
								<p class="flex gap-4">
									<span class="shrink-0 font-pixel text-[10px] uppercase tracking-[0.06em] text-dim">
										0{i + 1}
									</span>
									<span class="text-strong">{question}</span>
								</p>
							))
						}
					</div>

					<p class="mt-4 max-w-[52ch] text-[15px] leading-6 text-muted">
						{manifesto.statement}
					</p>

					<div
						class="mt-5 border-t border-line pt-3 font-pixel text-[9px] uppercase leading-5 tracking-[0.06em] text-dimtext"
					>
						<p>
							cipher / rot3:
							<span class="normal-case tracking-normal text-muted">{manifesto.cipher}</span>
						</p>
						<p class="text-dim">[ {manifesto.note} ]</p>
					</div>
				</section>

				<section class="mt-20 scroll-mt-8" id="work" aria-labelledby="work-heading">
					<SectionHeading
						index="01"
						label="work"
						tag={`[${count} files]`}
						titleId="work-heading"
						rule
					/>

					<div class="mt-6 grid gap-5 sm:grid-cols-2">
						{projects.map((project) => <Project project={project} />)}
					</div>
				</section>

				<section class="mt-20 scroll-mt-8" id="about" aria-labelledby="about-heading">
					<SectionHeading index="02" label="about" tag="[identity]" titleId="about-heading" />

					<div class="mt-5">
						<p class="max-w-[62ch] border-l-2 border-accent pl-4 text-[16px] leading-7 text-fg [text-wrap:pretty]">{about.body}</p>

					</div>
				</section>


				<section class="mt-20 scroll-mt-8" id="contact" aria-labelledby="contact-heading">
					<SectionHeading
						index="03"
						label="contact"
						tag="[open channel]"
						titleId="contact-heading"
					/>

					<div class="mt-5 grid">
						{
							site.contact.map((item, i) => (
								<a
									class="group flex items-baseline justify-between gap-4 border-b border-line py-2.5 no-underline"
									href={item.href}
								>
									<span class="flex items-baseline gap-3">
										<span class="font-pixel text-[10px] tracking-[0.06em] text-dim">[0{i + 1}]</span>
										<span class="font-bold text-strong underline decoration-line underline-offset-4 visited:text-muted group-hover:text-strong group-hover:decoration-strong">
											{item.label}
										</span>
									</span>
									<span class="text-dim transition-transform duration-200 group-hover:translate-x-1 group-hover:text-accent" aria-hidden="true">-&gt;</span>
								</a>
							))
						}
					</div>

				</section>
			</main>

			<Footer />
		</div>
	</div>
</Layout>
