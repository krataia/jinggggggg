---
import { existsSync } from 'node:fs';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Project from '../components/Project.astro';
import Footer from '../components/Footer.astro';
import MusicBar from '../components/MusicBar.astro';
import Starfield from '../components/Starfield.astro';
import Intro from '../components/Intro.astro';
import Layout from '../layouts/Layout.astro';
import { about, manifesto, projects, site } from '../data/portfolio';

const count = String(projects.length).padStart(2, '0');

// Optional hero backdrop: drop public/hero-bg.jpg (or .webp/.png) and it replaces the CSS sky.
const heroBg = ['jpg', 'webp', 'png']
	.map((ext) => `hero-bg.${ext}`)
	.find((name) => existsSync(`${process.cwd()}/public/${name}`));
---

<Layout>
	<Intro />
	<Starfield />
	{
		heroBg && (
			<div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[120svh] overflow-hidden" aria-hidden="true">
				<img class="absolute inset-0 h-full w-full object-cover object-center" src={`/${heroBg}`} alt="" decoding="async" fetchpriority="high" />
				<!-- dark wash so the title stays readable, fading into the night sky -->
				<span class="absolute inset-0 bg-[linear-gradient(to_bottom,rgb(18_20_36/0.55),rgb(18_20_36/0.35)_40%,rgb(34_38_61/0.85)_80%,var(--color-bg))]" />
			</div>
		)
	}
	<Header />

	<div class="mx-auto w-[calc(100%-40px)] max-w-[1040px] pb-28">
		<main id="main">
			<Hero />

			<section class="scroll-mt-24 pt-16" id="manifesto" aria-labelledby="manifesto-heading">
				<SectionHeading label="manifesto" tag="why" titleId="manifesto-heading" />

				<!-- one line, framed by corner brackets -->
				<figure class="corners relative mx-auto mt-12 max-w-[760px] px-8 py-12 text-center sm:px-14">
					<blockquote class="font-display text-[clamp(26px,4.6vw,44px)] font-semibold leading-[1.2] tracking-[0.02em] text-strong [text-wrap:balance]">
						{manifesto.statement}
					</blockquote>
					<figcaption class="mt-6 font-mono text-[11px] uppercase leading-5 tracking-[0.14em] text-dimtext">
						rot3 · <span class="normal-case tracking-normal text-accent/80">{manifesto.cipher}</span>
					</figcaption>
				</figure>
			</section>

			<section class="scroll-mt-24 pt-32" id="work" aria-labelledby="work-heading">
				<SectionHeading label="work" tag={`${count} certificates`} titleId="work-heading" />

				<div class="mt-12 grid gap-3">
					{projects.map((project) => <Project project={project} />)}
				</div>
			</section>

			<section class="scroll-mt-24 pt-32" id="about" aria-labelledby="about-heading">
				<SectionHeading label="about" tag="identity" titleId="about-heading" />

				<div class="corners relative mx-auto mt-12 max-w-[680px] bg-panel/60 px-8 py-10 text-center sm:px-14">
					<p class="text-[18px] leading-9 text-fg [text-wrap:pretty]">{about.body}</p>
				</div>
			</section>

			<section class="scroll-mt-24 pt-32" id="contact" aria-labelledby="contact-heading">
				<SectionHeading label="contact" tag="open channel" titleId="contact-heading" />

				<div class="mx-auto mt-12 max-w-[680px] border-y border-line">
					{
						site.contact.map((item) => (
							<a
								class="group flex items-center justify-between gap-4 px-4 py-5 no-underline transition-colors duration-200 hover:bg-accent-soft"
								href={item.href}
								target="_blank"
								rel="noopener"
							>
								<span class="flex items-center gap-4">
									<span class="diamond size-2 border border-accent/70 transition-colors duration-200 group-hover:bg-accent" aria-hidden="true" />
									<span class="text-[17px] font-medium text-strong transition-colors duration-200 group-hover:text-accent">
										{item.label}
									</span>
								</span>
								<span class="text-muted transition-[color,transform] duration-200 group-hover:translate-x-1 group-hover:text-accent" aria-hidden="true">
									&rarr;
								</span>
							</a>
						))
					}
				</div>
			</section>
		</main>

		<Footer credit={heroBg ? site.heroCredit : undefined} />
	</div>

	<MusicBar />
</Layout>
