---
import type { Project } from '../data/portfolio';

interface Props {
	project: Project;
}

const { project } = Astro.props;
const href = project.links.certificate;
---

<a
	class="band group relative block h-[132px] overflow-hidden rounded-[4px] bg-panel no-underline sm:h-[168px]"
	href={href}
	target="_blank"
	rel="noopener"
>
	<!-- certificate as the band's backdrop, fading into the dark on the left -->
	<img
		class="art absolute inset-y-0 right-0 h-full w-[68%] object-cover object-[center_22%] sm:w-[58%]"
		src={encodeURI(`/ผลงาน/${project.clip.replace(/\.\w+$/, '.jpg')}`)}
		alt=""
		loading="lazy"
		decoding="async"
	/>
	<span class="veil absolute inset-0" aria-hidden="true"></span>
	<span class="frame pointer-events-none absolute inset-0 rounded-[4px]" aria-hidden="true"></span>

	<div class="relative flex h-full items-center gap-4 px-5 sm:gap-6 sm:px-8">
		<span class="hidden shrink-0 flex-col items-center gap-2 sm:flex" aria-hidden="true">
			<span class="diamond size-2 border border-accent/80 transition-colors duration-200 group-hover:bg-accent"></span>
			<span class="font-mono text-[11px] tracking-[0.1em] text-accent/80">{project.number}</span>
		</span>

		<div class="min-w-0 max-w-[30rem]">
			<p class="font-mono text-[10px] uppercase tracking-[0.2em] text-dimtext">
				{project.year} · {project.stack}
			</p>
			<h3
				class="mt-1.5 text-[17px] font-semibold leading-snug text-strong transition-colors duration-200 group-hover:text-accent sm:text-[21px] [text-wrap:balance]"
			>
				{project.name}
			</h3>
			<p class="mt-1.5 line-clamp-1 text-[14px] leading-6 text-muted sm:line-clamp-2">{project.description}</p>
		</div>

		<span class="view relative ml-auto hidden shrink-0 items-center gap-2.5 overflow-hidden border border-accent/45 px-4 py-2 sm:flex" aria-hidden="true">
			<span class="view-fill absolute inset-0 bg-accent"></span>
			<span class="view-shine absolute inset-y-0 -left-1/2 w-1/2"></span>
			<span class="view-gem relative size-[7px] border border-accent"></span>
			<span class="view-label relative text-[12px] font-semibold uppercase leading-none text-accent">View</span>
			<span class="relative block h-3 w-3.5 overflow-hidden">
				<svg class="view-arrow view-arrow-out absolute inset-0" viewBox="0 0 14 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
					<path d="M1 6h11M8 2l4 4-4 4" />
				</svg>
				<svg class="view-arrow view-arrow-in absolute inset-0" viewBox="0 0 14 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
					<path d="M1 6h11M8 2l4 4-4 4" />
				</svg>
			</span>
		</span>
	</div>
</a>

<style>
	.art {
		mask-image: linear-gradient(to right, transparent, #000 45%);
		filter: saturate(0.6) brightness(0.55);
		opacity: 0.85;
		transition:
			transform 0.4s var(--ease-out-cubic),
			filter 0.4s ease-out,
			opacity 0.4s ease-out;
	}
	/* veil lifts on hover so the certificate comes forward */
	.veil {
		background: linear-gradient(to right, var(--color-panel) 32%, rgb(42 47 75 / 0.55) 72%, rgb(42 47 75 / 0.2));
		transition: opacity 0.4s ease-out;
	}
	.frame {
		box-shadow: inset 0 0 0 1px var(--color-line);
		transition: box-shadow 0.2s ease;
	}
	.band:hover .art,
	.band:focus-visible .art {
		transform: scale(1.05);
		filter: none;
		opacity: 1;
	}
	.band:hover .veil,
	.band:focus-visible .veil {
		opacity: 0.75;
	}
	.band:hover .frame,
	.band:focus-visible .frame {
		box-shadow:
			inset 0 0 0 2px var(--color-accent),
			0 10px 30px rgb(0 0 0 / 0.35);
	}
	/* View button: gold fill sweeps in, arrow swaps, gem spins, then a light streak passes */
	.view {
		--ease-io: cubic-bezier(0.65, 0, 0.35, 1);
		color: var(--color-accent);
		transition:
			border-color 0.3s ease,
			box-shadow 0.4s ease;
	}
	.view-fill {
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.45s var(--ease-io);
	}
	.view-shine {
		background: linear-gradient(100deg, transparent, rgb(255 255 255 / 0.55), transparent);
		transform: skewX(-20deg) translateX(0);
	}
	.view-gem {
		transform: rotate(45deg);
		transition:
			transform 0.5s var(--ease-io),
			background-color 0.3s ease,
			border-color 0.3s ease;
	}
	.view-label {
		letter-spacing: 0.16em;
		transition:
			letter-spacing 0.4s var(--ease-io),
			color 0.3s ease;
	}
	.view-arrow {
		transition: transform 0.4s var(--ease-io);
	}
	.view-arrow-in {
		transform: translateX(-130%);
	}
	.band:hover .view,
	.band:focus-visible .view {
		color: #1b1e33;
		border-color: var(--color-accent);
		box-shadow: 0 0 18px rgb(245 194 122 / 0.35);
	}
	.band:hover .view-fill,
	.band:focus-visible .view-fill {
		transform: scaleX(1);
	}
	.band:hover .view-shine,
	.band:focus-visible .view-shine {
		animation: view-shine 0.7s ease-out 0.35s;
	}
	.band:hover .view-gem,
	.band:focus-visible .view-gem {
		transform: rotate(225deg);
		background-color: #1b1e33;
		border-color: #1b1e33;
	}
	.band:hover .view-label,
	.band:focus-visible .view-label {
		color: #1b1e33;
		letter-spacing: 0.24em;
	}
	.band:hover .view-arrow-out,
	.band:focus-visible .view-arrow-out {
		transform: translateX(130%);
	}
	.band:hover .view-arrow-in,
	.band:focus-visible .view-arrow-in {
		transform: translateX(0);
		transition-delay: 0.08s;
	}
	@keyframes view-shine {
		to {
			transform: skewX(-20deg) translateX(320%);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.view-fill,
		.view-gem,
		.view-label,
		.view-arrow {
			transition-duration: 0.01s;
		}
		.band:hover .view-shine {
			animation: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.art {
			transition: none;
		}
		.band:hover .art {
			transform: none;
		}
	}
</style>
