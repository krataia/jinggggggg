<div class="sky-root pointer-events-none fixed inset-0 -z-20 overflow-hidden" aria-hidden="true">
	<!-- slow-moving nebula haze -->
	<span class="neb neb-a"></span>
	<span class="neb neb-b"></span>
	<span class="neb neb-c"></span>
	<canvas class="absolute inset-0 h-full w-full" data-stars></canvas>
	<!-- thin frame rails at the edges, desktop only -->
	<span class="rail left-[64px]"></span>
	<span class="rail right-[44px]"></span>
</div>

<style>
	.sky-root {
		background:
			radial-gradient(80% 60% at 70% 75%, rgb(92 100 140 / 0.35), transparent 70%),
			linear-gradient(to bottom, #20233a 0%, #2a2e4a 45%, #3b4062 80%, #4a5073 100%);
	}
	.neb {
		position: absolute;
		border-radius: 50%;
		filter: blur(60px);
		will-change: transform;
	}
	.neb-a {
		left: -10%;
		top: 10%;
		width: 70vw;
		height: 50vh;
		background: radial-gradient(closest-side, rgb(120 130 175 / 0.22), transparent);
		animation: neb-a 70s ease-in-out infinite alternate;
	}
	.neb-b {
		right: -15%;
		top: 35%;
		width: 80vw;
		height: 60vh;
		background: radial-gradient(closest-side, rgb(150 155 200 / 0.18), transparent);
		animation: neb-b 90s ease-in-out infinite alternate;
	}
	.neb-c {
		left: 25%;
		bottom: -20%;
		width: 60vw;
		height: 45vh;
		background: radial-gradient(closest-side, rgb(110 100 160 / 0.2), transparent);
		animation: neb-c 110s ease-in-out infinite alternate;
	}
	@keyframes neb-a {
		to {
			transform: translate(8vw, 4vh) scale(1.15) rotate(8deg);
		}
	}
	@keyframes neb-b {
		to {
			transform: translate(-10vw, -6vh) scale(1.2) rotate(-10deg);
		}
	}
	@keyframes neb-c {
		to {
			transform: translate(6vw, -8vh) scale(1.1);
		}
	}
	.rail {
		position: absolute;
		top: 64px;
		bottom: 0;
		width: 1px;
		background: linear-gradient(to bottom, transparent, rgb(255 255 255 / 0.14) 12%, rgb(255 255 255 / 0.14) 88%, transparent);
		display: none;
	}
	.rail::before,
	.rail::after {
		content: '';
		position: absolute;
		left: -2px;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: rgb(255 255 255 / 0.35);
	}
	.rail::before {
		top: 22%;
	}
	.rail::after {
		top: 64%;
	}
	@media (min-width: 1200px) {
		.rail {
			display: block;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.neb {
			animation: none;
		}
	}
</style>

<script>
	// Night sky: depth-layered twinkling stars + a drifting diagonal star-dust band, with soft pointer parallax.
	const canvas = document.querySelector<HTMLCanvasElement>('[data-stars]');
	const ctx = canvas?.getContext('2d');

	if (canvas && ctx) {
		const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
		type P = { x: number; y: number; r: number; a: number; tw: number; ph: number; z: number; v: number };
		let stars: P[] = [];
		let dust: P[] = [];
		let w = 0;
		let h = 0;
		let band = { ax: 0, ay: 0, dx: 0, dy: 0, len: 0, nx: 0, ny: 0 };
		const mouse = { x: 0, y: 0, tx: 0, ty: 0 };
		let shoot: { x: number; y: number; vx: number; vy: number; life: number } | null = null;
		let nextShoot = performance.now() + 5000;

		const gauss = () => (Math.random() + Math.random() + Math.random() + Math.random() - 2) / 2; // ~N(0, .3)

		const build = () => {
			const dpr = Math.min(devicePixelRatio || 1, 2);
			w = innerWidth;
			h = innerHeight;
			canvas.width = w * dpr;
			canvas.height = h * dpr;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			const n = Math.round((w * h) / 4200);
			stars = Array.from({ length: n }, () => {
				const z = Math.random(); // depth: 0 far .. 1 near
				const bright = Math.random() < 0.05;
				return {
					x: Math.random() * w,
					y: Math.random() * h,
					r: bright ? 1.1 + Math.random() * 0.8 : 0.3 + z * 0.7,
					a: bright ? 0.85 : 0.2 + z * 0.5,
					tw: 0.3 + Math.random() * 1.4,
					ph: Math.random() * Math.PI * 2,
					z,
					v: 0,
				};
			});

			// diagonal band from the right edge down toward the lower middle (like a strip of the Milky Way)
			const ax = w * 1.02;
			const ay = h * 0.52;
			const bx = w * 0.5;
			const by = h * 1.05;
			const len = Math.hypot(bx - ax, by - ay);
			band = { ax, ay, dx: (bx - ax) / len, dy: (by - ay) / len, len, nx: -(by - ay) / len, ny: (bx - ax) / len };
			const m = Math.round(Math.min(1400, (w * h) / 1500));
			dust = Array.from({ length: m }, () => {
				const t = Math.pow(Math.random(), 1.6); // denser near the right edge
				const spread = (70 - t * 40) * Math.max(0.6, w / 1600);
				const off = gauss() * spread * 2.2;
				return {
					x: t * len, // position along the band (band coords)
					y: off, // offset across it
					r: Math.random() < 0.06 ? 0.9 + Math.random() * 0.5 : 0.25 + Math.random() * 0.55,
					a: (0.25 + Math.random() * 0.55) * (1 - t * 0.6),
					tw: 0.5 + Math.random() * 2,
					ph: Math.random() * Math.PI * 2,
					z: 0.6 + Math.random() * 0.4,
					v: 3 + Math.random() * 6, // px/s drift along the band
				};
			});
		};

		let last = performance.now();
		const frame = (now: number) => {
			const dt = Math.min((now - last) / 1000, 0.05);
			last = now;
			const t = now / 1000;
			// ease pointer parallax so it glides instead of snapping
			mouse.x += (mouse.tx - mouse.x) * 0.04;
			mouse.y += (mouse.ty - mouse.y) * 0.04;

			ctx.clearRect(0, 0, w, h);
			ctx.fillStyle = '#fff';

			for (const s of stars) {
				const tw = reduce ? 1 : 0.6 + 0.4 * Math.sin(t * s.tw + s.ph);
				const x = s.x - mouse.x * s.z * 14;
				const y = s.y - mouse.y * s.z * 10;
				ctx.globalAlpha = s.a * tw;
				if (s.r < 0.8) {
					ctx.fillRect(x, y, s.r * 1.6, s.r * 1.6);
				} else {
					ctx.beginPath();
					ctx.arc(x, y, s.r, 0, Math.PI * 2);
					ctx.fill();
					ctx.globalAlpha = s.a * tw * 0.15;
					ctx.beginPath();
					ctx.arc(x, y, s.r * 4, 0, Math.PI * 2);
					ctx.fill();
				}
			}

			for (const d of dust) {
				if (!reduce) {
					d.x += d.v * dt;
					if (d.x > band.len) d.x -= band.len;
				}
				const tw = reduce ? 1 : 0.55 + 0.45 * Math.sin(t * d.tw + d.ph);
				const x = band.ax + band.dx * d.x + band.nx * d.y - mouse.x * d.z * 20;
				const y = band.ay + band.dy * d.x + band.ny * d.y - mouse.y * d.z * 14;
				if (x < -4 || x > w + 4 || y < -4 || y > h + 4) continue;
				ctx.globalAlpha = d.a * tw;
				ctx.fillRect(x, y, d.r * 1.7, d.r * 1.7);
			}

			if (!reduce) {
				if (!shoot && now > nextShoot) {
					shoot = { x: w * (0.3 + Math.random() * 0.6), y: h * Math.random() * 0.3, vx: -520, vy: 240, life: 1 };
				}
				if (shoot) {
					const tx = shoot.x - shoot.vx * 0.12;
					const ty = shoot.y - shoot.vy * 0.12;
					const g = ctx.createLinearGradient(shoot.x, shoot.y, tx, ty);
					g.addColorStop(0, `rgba(255,255,255,${0.85 * shoot.life})`);
					g.addColorStop(1, 'rgba(255,255,255,0)');
					ctx.globalAlpha = 1;
					ctx.strokeStyle = g;
					ctx.lineWidth = 1.1;
					ctx.beginPath();
					ctx.moveTo(shoot.x, shoot.y);
					ctx.lineTo(tx, ty);
					ctx.stroke();
					shoot.x += shoot.vx * dt;
					shoot.y += shoot.vy * dt;
					shoot.life -= dt * 1.1;
					if (shoot.life <= 0) {
						shoot = null;
						nextShoot = now + 8000 + Math.random() * 10000;
					}
				}
				requestAnimationFrame(frame);
			}
			ctx.globalAlpha = 1;
		};

		addEventListener(
			'pointermove',
			(e) => {
				mouse.tx = e.clientX / w - 0.5;
				mouse.ty = e.clientY / h - 0.5;
			},
			{ passive: true },
		);
		addEventListener('resize', build);
		build();
		requestAnimationFrame(frame);
	}
</script>
