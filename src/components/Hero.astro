---

<section class="mt-6 scroll-mt-8" id="top" aria-labelledby="hero-title">
	<!-- flex centers the art even when it is wider than the column -->
	<div class="flex justify-center overflow-x-clip py-10">
		<pre
			class="w-max shrink-0 whitespace-pre font-pixel text-[clamp(6px,2.1vw,15px)] leading-none text-fg"
			aria-hidden="true">{cicada}</pre>
	</div>

	<div class="mt-6">
		<p class="font-pixel text-[11px] uppercase tracking-[0.1em] text-dimtext">
			<span class="text-accent">&gt;</span> {hero.prompt}
		</p>
		<h1 class="mt-2 text-[clamp(28px,6vw,44px)] font-bold leading-[1.05] tracking-[-0.02em] text-strong" id="hero-title">
			{site.name}<span
				class="ml-1 inline-block h-[0.8em] w-[0.45em] translate-y-[0.08em] animate-blink bg-accent motion-reduce:animate-none"
				aria-hidden="true"></span>
		</h1>
		<p class="mt-4 max-w-[52ch] text-[17px] leading-7">
			{hero.lines[0]}<br />
			{hero.lines[1]}
		</p>
		<p class="mt-3 text-[15px] leading-6 text-muted">
			{hero.closing}<br />
			<span class="text-strong">{hero.remark}</span>
		</p>
		<p class="mt-6 flex flex-wrap gap-x-5 gap-y-2 font-pixel text-[11px] uppercase tracking-[0.1em]">
			<a class="text-accent no-underline hover:underline hover:underline-offset-4" href="#work">[ view work ]</a>
			<a class="text-muted no-underline hover:text-strong" href={github} target="_blank" rel="noopener">[ github ]</a>
		</p>
	</div>
</section>
