---
import { github, hero, site } from '../data/portfolio';

const cicada = `⠀⠀⣀⣤⠤⠶⠶⠶⠶⠶⠶⢶⠶⠶⠦⣤⣄⣀⣀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢀⣠⣤⣶⣦⣤⣀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢀⣀⣀⣤⡤⣤⠶⠴⠶⠶⠶⣶⠶⠶⢤⣤⣀⡀
⣴⡏⠡⢒⡸⠋⠀⠐⣾⠉⠉⠭⢄⣠⢤⡷⠷⢾⣛⣿⠷⣶⣤⣄⡀⠀⠀⠐⢿⣟⢲⡁⠐⣾⠛⠃⠀⠀⢀⣠⡤⠶⠒⣛⣩⠝⢋⣠⣰⣂⣤⠴⠏⠉⠓⢺⡿⢁⣴⣮⢽⡟
⠙⠶⣞⣥⡴⠚⣩⣦⠨⣷⠋⠠⠤⠶⢲⡺⠢⣤⡼⠿⠛⠛⣻⣿⣿⠿⢶⣤⣿⣯⡾⠗⠾⣇⣙⣤⡶⢿⣯⡕⢖⣺⠋⣭⣤⣤⢤⡶⠖⠮⢷⡄⠛⠂⣠⣽⡟⢷⣬⡿⠋⠁
⠀⠀⠀⠈⠒⢿⣁⡴⠟⣊⣇⠠⣴⠞⣉⣤⣷⣤⠶⠿⢛⢛⠩⠌⠚⢁⣴⣿⠏⠀⣴⠀⢀⣦⠻⠻⣑⠢⢕⡋⢿⡿⣿⣷⢮⣤⣷⣬⣿⠷⠈⢁⣤⣾⡿⣽⡮⠋⠀⠀⠀⠀
⠀⠀⠀⠀⠀⠈⠛⠷⣾⣋⣤⡾⠛⣁⡡⢤⡾⢤⡖⠋⠉⠀⠀⠀⠀⠀⢰⣿⡷⠺⠛⠐⡿⠃⠦⠤⠈⠉⠢⠄⠈⠁⠙⢿⣮⣿⢤⣶⣁⣀⣛⣿⣷⠼⠚⠁⠀⠀⠀⠀⠀⠀
⠀⠀⠀⠀⠀⠀⠀⠀⠉⠛⠙⠇⠀⣩⡥⠞⢗⣼⣧⠀⠀⠀⠀⠀⠀⠀⢈⣿⡇⢄⡤⠤⣧⠄⢀⡀⠀⠀⠀⠀⠀⠀⠀⢘⣿⡟⠺⣯⣽⡉⠉⠉⠉⠀⠀⠀⠀⠀⠀⠀⠀⠀
⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⣾⠇⣊⣭⢿⡛⠁⡅⠀⠀⠀⠀⠀⠀⠈⢻⡇⢘⣡⣀⡀⣏⠀⠃⠀⠀⠀⠀⠀⠀⠀⣸⡏⠈⢦⣶⣿⡟⠃⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠙⢿⣥⡔⣫⠔⡀⡰⠀⠀⠀⠀⠀⠀⠀⢺⡇⠈⢰⠀⢹⠇⠀⡘⡄⠀⠀⠀⠀⠀⢠⣿⣄⢠⣾⣿⠟⠁⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠈⠛⠷⠺⠘⠛⠛⠓⢂⠀⠀⠀⠀⠸⣧⠀⢺⠀⠊⠀⠰⠇⠘⢄⡀⠀⠰⠶⡛⠓⠟⠋⠉⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢹⣆⠛⠒⠁⠀⠀⠀⠀⠀⠈⠁⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠻⣆⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠻⠇⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀`;
---

<section
	class="relative flex min-h-[100svh] scroll-mt-0 flex-col items-center justify-center pb-24 pt-24 text-center"
	id="top"
	aria-labelledby="hero-title"
>
	<!-- warm halo behind the key art -->
	<div
		class="pointer-events-none absolute inset-x-0 top-[12%] mx-auto h-[420px] max-w-[760px] bg-[radial-gradient(closest-side,rgb(245_194_122/0.12),transparent)]"
		aria-hidden="true"
	>
	</div>

	<!-- flex centers the art even when it is wider than the column -->
	<div class="relative flex w-full justify-center overflow-x-clip py-6">
		<div class="animate-breath motion-reduce:animate-none">
			<!-- two copies of the art, clipped at the body line; each half rotates in 3D like a wing -->
			<div class="cicada relative shrink-0" aria-hidden="true">
				<pre class="wing wing-l w-max whitespace-pre font-pixel text-[clamp(6px,2.1vw,15px)] leading-none text-fg">{cicada}</pre>
				<pre class="wing wing-r absolute inset-0 w-max whitespace-pre font-pixel text-[clamp(6px,2.1vw,15px)] leading-none text-fg">{cicada}</pre>
			</div>
		</div>
	</div>

	<p class="relative mt-8 font-mono text-[11px] uppercase tracking-[0.3em] text-accent/80">{hero.prompt}</p>
	<h1
		class="relative mt-3 font-display text-[clamp(34px,7vw,68px)] font-semibold leading-[1.05] tracking-[0.04em] text-strong [text-wrap:balance]"
		id="hero-title"
	>
		{site.name}
	</h1>
	<p class="relative mx-auto mt-5 max-w-[46ch] text-[17px] leading-8 text-muted [text-wrap:balance]">
		{hero.lines.join(' ')}{' '}
		<span class="text-strong">{hero.remark}</span>
	</p>

	<div class="relative mt-9 flex flex-wrap items-center justify-center gap-x-7 gap-y-4">
		<a class="cta relative inline-flex items-center bg-cta px-9 py-3 text-[14px] font-semibold uppercase text-[#2b1d06] no-underline" href="#work" data-cta>
			<!-- gold corner brackets that open outward on hover -->
			<span class="cta-frame" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
			<!-- a gold line that traces the border on hover -->
			<svg class="cta-trace" aria-hidden="true"><rect x="1" y="1" pathLength="100" /></svg>
			<span class="cta-clip" aria-hidden="true"><span class="cta-shine"></span></span>
			<span class="cta-label relative" data-scramble>View work</span>
		</a>
		<a
			class="text-[13px] font-medium uppercase tracking-[0.14em] text-muted no-underline transition-colors duration-200 hover:text-accent"
			href={github}
			target="_blank"
			rel="noopener">GitHub &rarr;</a
		>
	</div>

	<!-- scroll cue: three staggered blinking chevrons -->
	<a class="absolute bottom-24 left-1/2 grid -translate-x-1/2 justify-items-center text-accent/80 no-underline sm:bottom-10" href="#manifesto" aria-label="Scroll down">
		{
			[0, 0.5, 1].map((d) => (
				<svg class="-mt-1.5 h-3 w-5 animate-cue motion-reduce:animate-none" style={`animation-delay:${d}s`} viewBox="0 0 20 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
					<path d="m2 2 8 8 8-8" />
				</svg>
			))
		}
	</a>
</section>

<style>
	/* View work: lifts with a warm glow, brackets open, arrow drops through, light sweeps across */
	.cta {
		--io: cubic-bezier(0.65, 0, 0.35, 1);
		--mx: 0px;
		--my: 0px;
		transform: translate(var(--mx), var(--my));
		box-shadow: 0 6px 18px rgb(232 189 6 / 0.18);
		transition:
			transform 0.35s var(--io),
			box-shadow 0.35s ease,
			filter 0.25s ease;
	}
	.cta:hover,
	.cta:focus-visible {
		transform: translate(var(--mx), calc(var(--my) - 2px));
		filter: brightness(1.06);
		box-shadow:
			0 10px 28px rgb(232 189 6 / 0.35),
			0 0 0 1px rgb(255 240 190 / 0.6) inset;
	}
	.cta:active {
		transform: translate(var(--mx), var(--my)) scale(0.97);
		transition-duration: 0.08s;
	}
	.cta-label {
		letter-spacing: 0.14em;
		transition: letter-spacing 0.4s var(--io);
	}
	.cta:hover .cta-label,
	.cta:focus-visible .cta-label {
		letter-spacing: 0.2em;
	}
	.cta-frame {
		position: absolute;
		inset: -3px;
		opacity: 0;
		pointer-events: none;
		transition:
			inset 0.45s var(--io),
			opacity 0.3s ease;
	}
	.cta-frame i {
		position: absolute;
		width: 10px;
		height: 10px;
		border: 0 solid var(--color-accent);
	}
	.cta-frame i:nth-child(1) {
		top: 0;
		left: 0;
		border-width: 1.5px 0 0 1.5px;
	}
	.cta-frame i:nth-child(2) {
		top: 0;
		right: 0;
		border-width: 1.5px 1.5px 0 0;
	}
	.cta-frame i:nth-child(3) {
		bottom: 0;
		left: 0;
		border-width: 0 0 1.5px 1.5px;
	}
	.cta-frame i:nth-child(4) {
		bottom: 0;
		right: 0;
		border-width: 0 1.5px 1.5px 0;
	}
	.cta:hover .cta-frame,
	.cta:focus-visible .cta-frame {
		inset: -9px;
		opacity: 1;
	}
	.cta-clip {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}
	.cta-shine {
		position: absolute;
		inset: 0 auto 0 -60%;
		width: 45%;
		background: linear-gradient(100deg, transparent, rgb(255 255 255 / 0.65), transparent);
		transform: skewX(-20deg);
		animation: cta-idle 4.5s ease-in-out 2.5s infinite;
	}
	.cta:hover .cta-shine,
	.cta:focus-visible .cta-shine {
		animation: cta-sweep 0.75s ease-out;
	}
	@keyframes cta-idle {
		0%,
		70% {
			left: -60%;
		}
		100% {
			left: 130%;
		}
	}
	@keyframes cta-sweep {
		from {
			left: -60%;
		}
		to {
			left: 130%;
		}
	}
	.cta-trace {
		position: absolute;
		inset: -5px;
		width: calc(100% + 10px);
		height: calc(100% + 10px);
		overflow: visible;
		pointer-events: none;
	}
	.cta-trace rect {
		width: calc(100% - 2px);
		height: calc(100% - 2px);
		fill: none;
		stroke: var(--color-accent);
		stroke-width: 1.2;
		stroke-dasharray: 100;
		stroke-dashoffset: 100;
		filter: drop-shadow(0 0 4px rgb(245 194 122 / 0.8));
		transition: stroke-dashoffset 0.7s var(--io);
	}
	.cta:hover .cta-trace rect,
	.cta:focus-visible .cta-trace rect {
		stroke-dashoffset: 0;
	}
	.cta-label {
		display: inline-block;
		text-align: center;
		white-space: nowrap;
	}
	@media (prefers-reduced-motion: reduce) {
		.cta,
		.cta-label,
		.cta-frame,
		.cta-trace rect {
			transition-duration: 0.01s;
		}
		.cta-shine,
		.cta:hover .cta-shine {
			animation: none;
		}
		.cta:hover {
			transform: none;
		}
	}
	.cicada {
		--axis: 48.5%; /* column of the body / tail in the art */
		perspective: 700px;
		animation: hover 4s ease-in-out infinite;
	}
	.wing {
		margin: 0;
		transform-origin: var(--axis) 50%;
		will-change: transform;
	}
	.wing-l {
		clip-path: inset(0 calc(100% - var(--axis)) 0 0);
		animation: flap-l 3.2s steps(2, jump-end) infinite;
	}
	.wing-r {
		clip-path: inset(0 0 0 var(--axis));
		animation: flap-r 3.2s steps(2, jump-end) infinite;
	}
	/* two quick beats, then glide */
	@keyframes flap-l {
		0%, 36%, 100% { transform: rotateY(0deg); }
		9%, 27% { transform: rotateY(58deg); }
		18% { transform: rotateY(4deg); }
	}
	@keyframes flap-r {
		0%, 36%, 100% { transform: rotateY(0deg); }
		9%, 27% { transform: rotateY(-58deg); }
		18% { transform: rotateY(-4deg); }
	}
	@keyframes hover {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-6px); }
	}
	@media (prefers-reduced-motion: reduce) {
		.cicada,
		.wing {
			animation: none;
		}
	}
</style>

<script>
	// View work: text decrypts on hover; the button is gently pulled toward the pointer
	const cta = document.querySelector<HTMLElement>('[data-cta]');
	const label = cta?.querySelector<HTMLElement>('[data-scramble]');
	const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (cta && label && !still) {
		const text = label.textContent?.trim() ?? '';
		const glyphs = '01<>/\\#$%&*+=?!ABCDEFGHJKLMNPQRSTUVWXYZ';
		label.style.width = `${label.offsetWidth}px`; // keep the button from jittering while letters change
		let raf = 0;

		const scramble = () => {
			cancelAnimationFrame(raf);
			const start = performance.now();
			const dur = 650;
			const tick = (now: number) => {
				const p = Math.min((now - start) / dur, 1);
				const revealed = Math.floor(p * text.length);
				label.textContent = [...text]
					.map((ch, i) => (ch === ' ' || i < revealed ? ch : glyphs[Math.floor(Math.random() * glyphs.length)]))
					.join('');
				if (p < 1) raf = requestAnimationFrame(tick);
			};
			raf = requestAnimationFrame(tick);
		};

		cta.addEventListener('pointerenter', scramble);
		cta.addEventListener('focus', scramble);
		cta.addEventListener('pointermove', (e) => {
			const r = cta.getBoundingClientRect();
			const x = (e.clientX - (r.left + r.width / 2)) / (r.width / 2);
			const y = (e.clientY - (r.top + r.height / 2)) / (r.height / 2);
			cta.style.setProperty('--mx', `${(x * 6).toFixed(1)}px`);
			cta.style.setProperty('--my', `${(y * 4).toFixed(1)}px`);
		});
		cta.addEventListener('pointerleave', () => {
			cta.style.setProperty('--mx', '0px');
			cta.style.setProperty('--my', '0px');
		});
	}
</script>
