---
import { site } from '../data/portfolio';

const { credit } = Astro.props as { credit?: string };
---

<footer class="mt-32 border-t border-line pt-10 text-center">
	<p class="flex items-center justify-center gap-3 font-display text-[18px] font-semibold tracking-[0.1em] text-strong">
		<span class="diamond size-1.5 bg-accent" aria-hidden="true"></span>
		{site.handle}
		<span class="diamond size-1.5 bg-accent" aria-hidden="true"></span>
	</p>
	<p class="mt-3 font-mono text-[11px] uppercase tracking-[0.16em] text-dimtext">
		{site.year} · utc <time data-clock>--:--:--</time>
	</p>
	{credit && <p class="mx-auto mt-4 max-w-[60ch] text-[12px] leading-5 text-dimtext">{credit}</p>}
</footer>
